class Solution:
    def countArrangement(self, n: int) -> int:
        used=[False]*(n+1)
        ans=0
        def dfs(pos):
            nonlocal ans
            if pos>n:
                ans+=1
                return 
            for x in range(1,n+1):
                if not used[x] and (x % pos==0 or pos % x==0):
                    used[x]=True
                    dfs(pos+1)
                    used[x]=False
        dfs(1)
        return ans
        
