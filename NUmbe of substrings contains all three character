class Solution:
    def numberOfSubstrings(self, s: str) -> int:
        n=len(s)
        left=0
        count={'a':0,'b':0,'c':0}
        res=0
        for r in range(n):
            count[s[r]]+=1
            while count['a']>0 and count['b']>0 and count['c']>0:
                res+=n-r
                count[s[left]]-=1 #shrink the left values
                left+=1
        return res


        
